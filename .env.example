# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs creados en el dashboard de Stripe
STRIPE_PRICE_MONTHLY=price_xxx_mensual_5usd
STRIPE_PRICE_ANNUAL=price_xxx_anual_49usd
